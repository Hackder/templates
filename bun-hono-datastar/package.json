{
  "name": "bun-hono-datastar",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "scripts": {
    "dev": "NODE_ENV=development bun run --watch src/main.ts",
    "logview": "bun run --watch tools/logview/main.tsx",
    "tailwind": "tailwindcss -i ./src/input.css -o ./static/styles.css --watch",
    "tailwind:build": "tailwindcss -i ./src/input.css -o ./static/styles.css --minify",
    "typecheck": "tsc && tsc -p tsconfig.browser.json",
    "lint": "oxlint",
    "tc": "bun run typecheck && bun run lint",
    "format:check": "oxfmt --check",
    "format:fix": "oxfmt",
    "test": "bun test --parallel",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:generate": "bun node_modules/drizzle-kit/bin.cjs generate",
    "db:push": "bun node_modules/drizzle-kit/bin.cjs push",
    "db:studio": "bun node_modules/drizzle-kit/bin.cjs studio",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test && bun run tailwind:build"
  },
  "dependencies": {
    "@libsql/client": "0.17.4",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.1",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@oxc-project/types": "0.150.0",
    "@oxlint/plugins": "1.88.0",
    "@playwright/test": "1.62.1",
    "@shadcn/lint": "0.2.1",
    "@tailwindcss/cli": "4.3.3",
    "@total-typescript/ts-reset": "0.6.1",
    "bun-types": "1.4.3",
    "drizzle-kit": "0.31.10",
    "oxc-parser": "0.150.0",
    "oxfmt": "0.64.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2003",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
