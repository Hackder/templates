# The defaults are suitable for local development.
NODE_ENV=development
PORT=3000

# Local libSQL by default. Set the optional values for a Turso database or
# embedded replica.
TURSO_DATABASE_URL=file:./data/app.db
TURSO_AUTH_TOKEN=
TURSO_REMOTE_SYNC_URL=disabled
TURSO_SYNC_PULL_INTERVAL_MS=disabled

# Optional deterministic clock used by E2E tests.
MOCK_TIME=
